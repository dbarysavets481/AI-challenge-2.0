    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nif (!rows.length) {\n  return [{\n    json: {\n      message: 'No saved materials found. Send /learn <url> first.'\n    }\n  }];\n}\n\nconst lines = rows.map((item, index) => {\n  const summary = item.json.summary || '';\n  const url = item.json.url || '';\n\n  const titleMatch = summary.match(/Title:\\s*(.+)/i);\n  const title = titleMatch ? titleMatch[1].trim() : url;\n\n  return `${index + 1}. ${title}`;\n});\n\nreturn [{\n  json: {\n    message: `Choose a material for quiz:\n\n${lines.join('\\n')}\n\nReply with:\n/quiz1 - material 1\n/quiz2 - material 2\n/quiz3 - material 3\n/quiz4 - material 4\n/quiz5 - material 5`\n  }\n}];"
      },
