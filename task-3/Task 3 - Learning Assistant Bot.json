        "jsCode": "const html = $json.data || '';\n\nconst cleaned = html\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst url = $('Telegram Trigger').item.json.message.text.split(' ')[1];\n\nreturn [{\n  json: {\n    url,\n    content: cleaned.slice(0, 8000),\n    originalLength: cleaned.length\n  }\n}];"
